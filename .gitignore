# ─── Dependencies ─────────────────────────────────────────────
node_modules/
.npm/

# ─── Build / Compiled output ──────────────────────────────────
dist/
build/

# ─── Environment secrets — NEVER commit these ─────────────────
backend/.env
frontend/.env
.env
.env.local
.env.*.local

# ─── Uploads (user-generated files, not source code) ──────────
backend/uploads/*
!backend/uploads/.gitkeep

# ─── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*

# ─── OS / IDE ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─── Capacitor / Android build artifacts ──────────────────────
capacitor-app/node_modules/
capacitor-app/android/.gradle/
capacitor-app/android/build/
capacitor-app/android/app/build/
capacitor-app/android/.idea/
capacitor-app/android/local.properties

# ─── Misc ─────────────────────────────────────────────────────
*.db
*.sqlite
replace.py
