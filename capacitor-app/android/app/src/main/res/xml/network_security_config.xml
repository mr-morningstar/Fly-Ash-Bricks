<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config for DEV Fly Ash Bricks Android App.
  Allows cleartext (HTTP) traffic to the local backend server IP.
  For production: remove the <domain> entry and use HTTPS instead.
-->
<network-security-config>
    <!-- Allow HTTP to the local WiFi backend server -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.29.16</domain>
    </domain-config>
    <!-- Block cleartext for everything else (good security default) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
