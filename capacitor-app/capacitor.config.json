{
  "appId": "com.devbricks.app",
  "appName": "DEV Fly Ash Bricks",
  "webDir": "../frontend",
  "android": {
    "backgroundColor": "#0f172a",
    "allowMixedContent": false
  },
  "server": {
    "url": "https://fly-ash-bricks.vercel.app",
    "cleartext": false,
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#0f172a"
    }
  }
}
